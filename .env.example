# 복사해서 .env 로 쓰세요. .env 는 gitignore 됩니다.

# --- Step 2+: 데이터 경로 ---
RFA_DATA_DIR=./data

# --- Step 5+: 결재 서명 키 (openssl rand -hex 32) ---
RFA_CLEARANCE_KEY=

# --- Step 7+: GitHub ---
GITHUB_TOKEN=                # fine-grained PAT, 감시 레포 한정: Issues read/write (+ Pull requests read)
RFA_GITHUB_LOGIN=            # 멘션을 찾을 내 GitHub 아이디 (예: zetwhite)
RFA_GITHUB_REPOS=            # 감시할 레포, 쉼표로 구분 (예: zetwhite/rfa-test)
GITHUB_MCP_TOKEN=            # MCP 서버 bearer (openssl rand -hex 24). GitHub 토큰과 다름
RFA_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,172.18.0.1:*   # MCP 서버 Host 헤더 허용 목록 (샌드박스 주소 포함)
RFA_PUBLISHER=mock           # mock | github

# --- Step 10+: 샌드박스 ---
RFA_SANDBOX_HOST=172.18.0.1  # OpenShell docker 네트워크의 호스트 IP (docker network inspect openshell-docker)
RFA_TLS_CERT=certs/host.pem  # scripts/make_certs.sh 결과. github-mcp 의 샌드박스 바인드(HTTPS)용
RFA_TLS_KEY=certs/host.key
RFA_SANDBOX=rfa              # 만들 샌드박스 이름
RFA_DESK_CRON="*/5 * * * *"  # public-desk 를 깨우는 주기 (공백이 있어 따옴표 필수)

# --- Step 8+: 워크플로 ---
RFA_LLM_MODE=mock            # mock(키 없이 규칙 기반) | anthropic
ANTHROPIC_API_KEY=           # 호스트 개발용. 샌드박스 안에서는 비워 두고 ANTHROPIC_BASE_URL 사용
ANTHROPIC_BASE_URL=          # 샌드박스: https://inference.local
RFA_MODEL=claude-opus-5
REVIEW_URL=http://127.0.0.1:8790
KNOWLEDGE_URL=http://127.0.0.1:8791
GITHUB_MCP_URL=http://127.0.0.1:8792/github/mcp   # 호스트 데스크(desk-once)가 멘션을 받는 곳
