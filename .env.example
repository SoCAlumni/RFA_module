# 복사해서 .env 로 쓰세요. .env 는 gitignore 됩니다.
# 키는 그 키를 읽는 코드가 들어오는 단계에서 추가합니다 (docs/develop_plan.md).

# --- 데이터 경로 ---
# head_stub 은 <RFA_DATA_DIR>/knowledge 를 읽고, 결재 서버는 <RFA_DATA_DIR>/state 에 안건을 쓴다
RFA_DATA_DIR=./data

# --- 결재 서버 (approvals) ---
RFA_PUBLISHER=mock           # mock(게시하지 않고 기록만). 실제 채널 게시(live)는 Step 4
RFA_CORS_ORIGINS=*           # 프런트 주소, 쉼표로 구분 (예: http://localhost:5173)

# --- GitHub 채널 ---
GITHUB_TOKEN=                # fine-grained PAT, 감시 레포 한정: Issues read/write
RFA_GITHUB_LOGIN=            # 멘션을 찾을 내 GitHub 아이디 (예: zetwhite)
RFA_GITHUB_REPOS=            # 감시할 레포, 쉼표로 구분 (예: zetwhite/rfa-test)
