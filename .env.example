# 복사해서 .env 로 쓰세요. .env 는 gitignore 됩니다.
# 키는 그 키를 읽는 코드가 들어오는 단계에서 추가합니다 (docs/develop_plan.md).

# --- 데이터 경로 ---
# head_stub 은 <RFA_DATA_DIR>/knowledge 를 읽고, 결재 서버는 <RFA_DATA_DIR>/state 에 안건을 쓴다
RFA_DATA_DIR=./data

# --- 결재 서버 (approvals) ---
RFA_PUBLISHER=mock           # mock(게시하지 않고 기록만) | live(RFA_CHANNELS 의 실제 채널에 게시)
RFA_CORS_ORIGINS=*           # 프런트 주소, 쉼표로 구분 (예: http://localhost:5173)

# --- 대응 에이전트 (workflow) ---
HEAD_URL=http://127.0.0.1:8791        # head agent. 민섭님 서버가 오면 여기만 바꾼다
APPROVALS_URL=http://127.0.0.1:8790   # 결재 서버
RFA_LLM_MODE=openrouter      # mock(키 없이 규칙 기반) | openrouter | nvidia | gemini | anthropic
RFA_MODEL=                   # 비우면 provider 기본값 (openrouter/nvidia→nemotron-3.5-lightning 무료, gemini→gemini-2.5-flash, anthropic→claude-sonnet-4-6)
OPENROUTER_API_KEY=          # https://openrouter.ai/keys 무료 발급 (기본, nemotron 무료)
NVIDIA_API_KEY=              # https://build.nvidia.com 발급 (nemotron 공식, RFA_LLM_MODE=nvidia)
GEMINI_API_KEY=              # https://aistudio.google.com/apikey 발급 (RFA_LLM_MODE=gemini)
ANTHROPIC_API_KEY=           # RFA_LLM_MODE=anthropic 일 때
ANTHROPIC_BASE_URL=          # 비워 두면 https://api.anthropic.com

# --- 채널 ---
RFA_CHANNELS=                # 켤 채널, 쉼표로 구분 (github,slack). 비우면 채널 없음 — 토큰 없이도 전체 흐름이 돈다
                             # 채널별 토큰 발급: docs/tokens.md

# GitHub — 받기 모드 두 가지 (docs/tokens.md)
RFA_GITHUB_MODE=mentions     # mentions(기본): RFA_GITHUB_REPOS 를 스캔해 @나 를 찾음. fine-grained PAT 로 충분
                             # notifications: 내 알림함을 폴링 — 남이 보낸 멘션·내 이슈의 댓글·지정·리뷰 요청을
                             #   레포 무관하게 받음. classic PAT 필요 (권한 notifications + public_repo)
GITHUB_TOKEN=                # mentions: fine-grained PAT (감시 레포 한정, Issues read/write)
                             # notifications: classic PAT (notifications + public_repo)
RFA_GITHUB_REPOS=            # 쉼표로 구분 (예: zetwhite/rfa-test). mentions: 감시할 레포(필수)
                             # notifications: 셀프 멘션을 받을 레포 + 알림 필터 (비우면 알림만, 전 레포)
RFA_GITHUB_LOGIN=            # (선택) 내 GitHub 아이디. 비우면 토큰으로 자동 감지

# Slack — 봇이 아니라 나로서 동작. 발급: docs/tokens.md (앱 생성은 slack-app-manifest.yaml 붙여넣기)
SLACK_USER_TOKEN=            # xoxp- (User OAuth Token). 나에게 온 DM·@나 멘션을 읽고 내 이름으로 답한다
SLACK_APP_TOKEN=             # xapp- (App-Level Token, connections:write). Socket Mode 연결용
